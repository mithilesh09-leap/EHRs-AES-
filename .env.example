# ==============================================================================
# EHR Guardian - Environment Configuration Template
# Copy this file to '.env' and populate with production secrets.
# ==============================================================================

# Flask Session Security Key
SECRET_KEY=generate-a-strong-random-hex-string-for-session-management-here

# Master AES-256 Encryption Key (Base64 encoded 32 bytes = 256 bits)
# Generated via: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=RUhSX0FFUzI1Nl9HQ01fREVWX0tFWV8zMkJZVEVTCE=

# Cryptographic Key Rotation Active Version (Increment when rotating keys)
KEY_ROTATION_VERSION=1

# Database Connection URL (PostgreSQL Production or SQLite Fallback)
# PostgreSQL format: postgresql+psycopg2://ehr_user:ehr_secure_password@localhost:5432/ehr_db
# SQLite fallback: sqlite:///ehr_system.db
DATABASE_URL=sqlite:///ehr_system.db

# Cookie & Session Flags
SESSION_COOKIE_SECURE=False
FLASK_ENV=development
